# --- Required ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/taskflow
JWT_SECRET=generate-a-long-random-string

# --- Server ---
PORT=5000
NODE_ENV=development
JWT_EXPIRE=7d
# Origin(s) allowed to call the API. Comma-separate to allow more than one.
FRONTEND_URL=http://localhost:5173

# --- Uploads ---
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx,txt
# Set only on Vercel (added automatically when you create a Blob store).
# When absent, uploads are written to server/uploads/tasks on local disk.
# BLOB_READ_WRITE_TOKEN=

# --- Reminders / cron ---
REMINDER_BEFORE_HOURS=24
CRON_TIMEZONE=UTC
# Required on Vercel: shared secret Vercel Cron sends to /api/cron/*
# CRON_SECRET=generate-a-long-random-string

# --- Email (optional: fill in to enable email notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@taskflow.com
